# Bare minimum to run in dev

CLOUDFLARE_API_TOKEN=
CLOUDFLARE_AI_GATEWAY_ID=
CLOUDFLARE_ACCOUNT_ID=

# --- everything else optional

# "AUTH_PROVIDERS": ["GOOGLE", "GITHUB", "EMAIL_PASSWORD"],
# If empty, no authentication will be required to access the app.
# If non-empty, at least one provider must be configured properly for
# authentication to work. 
AUTH_PROVIDERS=[]  

# Required only when AUTH_PROVIDERS is non-empty.
# BETTER_AUTH_SECRET=
EMAIL_FROM=noreply@indirectchat.com
EMAIL_FROM_NAME="Indirect Chat"
VERIFY_EMAIL=false
BROWSER_RATE_LIMIT=true
IP_RATE_LIMIT=true
PROMPT_MAX_CHARACTERS=3000

# Optional. Required only if the matching provider is enabled and should work.
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional. Set MODEL_PROVIDER=inception-direct to call Inception Labs directly.
# INCEPTION_API_KEY should be stored as a secret in deployed environments.
# MODEL_PROVIDER=inception-direct
# INCEPTION_MODEL=mercury-2
# INCEPTION_REASONING_EFFORT=medium
# INCEPTION_TEMPERATURE=0.75
# INCEPTION_MAX_TOKENS=8192
